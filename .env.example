# Vite inlines these at BUILD time, not run time. A missing one does not error
# at build; it white-screens in production. See CLAUDE.md RULE 2.
VITE_GEMINI_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# OAuth 2.0 Web client ID for the Google Calendar sync (Google Cloud Console >
# APIs & Services > Credentials). Not a secret - it ships in the bundle and is
# guarded by the authorized-origins list, not by being hidden. Leave it blank
# and the app still runs; the calendar button just reports it is unconfigured.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# SMTP Configuration
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
